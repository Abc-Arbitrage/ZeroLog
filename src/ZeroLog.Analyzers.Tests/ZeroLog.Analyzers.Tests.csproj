<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>roslyn5.0;roslyn4.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <EnableNUnitRunner>true</EnableNUnitRunner>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BuildingByReSharper)' != ''">
    <!-- Rider doesn't handle TFM aliases correctly -->
    <!--suppress MsbuildTargetFrameworkTagInspection -->
    <TargetFrameworks>roslyn5.0</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' != ''">
    <TargetFrameworkIdentifier>.NETCoreApp</TargetFrameworkIdentifier>
    <TargetFrameworkVersion>v10.0</TargetFrameworkVersion>

    <RoslynVersion Condition="'$(TargetFramework)' == 'roslyn4.0'">4.14.0</RoslynVersion>
    <RoslynVersion Condition="'$(TargetFramework)' == 'roslyn5.0'">5.9.0</RoslynVersion>
    <RoslynTestingVersion>1.1.4</RoslynTestingVersion>

    <DefineConstants Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(RoslynVersion)', '4.0'))">$(DefineConstants);ROSLYN4_0_OR_GREATER</DefineConstants>
    <DefineConstants Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(RoslynVersion)', '5.0'))">$(DefineConstants);ROSLYN5_0_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZeroLog.Analyzers\ZeroLog.Analyzers.csproj" />
    <ProjectReference Include="..\ZeroLog\ZeroLog.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(RoslynVersion)' != ''">
    <PackageReference Include="Microsoft.CodeAnalysis" VersionOverride="$(RoslynVersion)" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" VersionOverride="$(RoslynVersion)" NoWarn="NU1608" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" VersionOverride="$(RoslynTestingVersion)" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" VersionOverride="$(RoslynTestingVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Shouldly.DiffEngine" />
  </ItemGroup>

  <Import Project="../Tests.targets" />
  <Import Project="../ZeroLog/ZeroLog.targets" />

</Project>
