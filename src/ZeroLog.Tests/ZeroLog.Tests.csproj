<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <EnableNUnitRunner>true</EnableNUnitRunner>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <NoWarn>$(NoWarn);CS8002;ZL0001</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BuildingByReSharper)' == ''">
    <TargetFrameworks>$(TargetFrameworks);</TargetFrameworks>
    <TargetFrameworks>$(TargetFrameworks)$(TargetFrameworks.Replace(';', '_gen;'))</TargetFrameworks>
    <TargetFrameworks>$([MSBuild]::Unescape('$(TargetFrameworks.TrimEnd(';'))'))</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' != ''">
    <BaseTFM>$(TargetFramework.Replace('_gen', ''))</BaseTFM>
    <TargetFrameworkIdentifier>$([MSBuild]::GetTargetFrameworkIdentifier('$(BaseTFM)'))</TargetFrameworkIdentifier>
    <TargetFrameworkVersion>v$([MSBuild]::GetTargetFrameworkVersion('$(BaseTFM)', 2))</TargetFrameworkVersion>

    <ZeroLogSourceGenerators>false</ZeroLogSourceGenerators>
    <ZeroLogSourceGenerators Condition="$(TargetFramework.EndsWith('_gen'))">true</ZeroLogSourceGenerators>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZeroLog\ZeroLog.csproj" />
    <ProjectReference Include="..\ZeroLog.Analyzers\ZeroLog.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SetTargetFramework="TargetFramework=roslyn5.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="MarkdownSnippets.MsBuild" PrivateAssets="all" />
    <PackageReference Include="PublicApiGenerator" />
    <PackageReference Include="ObjectLayoutInspector" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Shouldly.DiffEngine" />
    <PackageReference Include="JetBrains.Annotations" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="TargetFramework" Value="$(TargetFramework)" />
  </ItemGroup>

  <ItemGroup>
    <None Update="LogTests.Messages.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>LogTests.Messages.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="LogTests.Messages.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>LogTests.Messages.tt</DependentUpon>
    </Compile>
  </ItemGroup>

  <Import Project="../Tests.targets" />
  <Import Project="../ZeroLog/ZeroLog.targets" />

</Project>
