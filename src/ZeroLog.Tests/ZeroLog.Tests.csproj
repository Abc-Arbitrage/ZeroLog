<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <EnableNUnitRunner>true</EnableNUnitRunner>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <NoWarn>$(NoWarn);CS8002</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZeroLog\ZeroLog.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageReference Include="MarkdownSnippets.MsBuild" Version="28.4.2" PrivateAssets="all" />
    <PackageReference Include="Verify.NUnit" Version="32.0.0" />
    <PackageReference Include="Verify.DiffPlex" Version="3.3.1" />
    <PackageReference Include="PublicApiGenerator" Version="11.5.4" />
    <PackageReference Include="ObjectLayoutInspector" Version="0.2.0" />
    <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Update="LogTests.Messages.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>LogTests.Messages.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="LogTests.Messages.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>LogTests.Messages.tt</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
