<Project>

  <PropertyGroup>
    <ZeroLogSourceGenerators Condition="'$(ZeroLogSourceGenerators)' == ''">true</ZeroLogSourceGenerators>
    <ZeroLogGenerateLoggerWarmup Condition="'$(ZeroLogGenerateLoggerWarmup)' == '' and '$(ZeroLogSourceGenerators)' == 'true'">true</ZeroLogGenerateLoggerWarmup>

    <ZeroLogEnabledGenerators />
    <ZeroLogEnabledGenerators Condition="'$(ZeroLogGenerateLoggerWarmup)' == 'true'">$(ZeroLogEnabledGenerators)LoggerWarmup,</ZeroLogEnabledGenerators>
    <ZeroLogEnabledGenerators Condition="'$(ZeroLogSourceGenerators)' != 'true'" />
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="ZeroLogEnabledGenerators" />
  </ItemGroup>

  <Target Name="ZeroLogSanityChack"
          BeforeTargets="Build"
          Condition="'$(ZeroLogSkipSanityCheck)' != 'true' and '$(DesignTimeBuild)' != 'true'">
    <Error Condition="$([MSBuild]::VersionLessThan($([MSBuild]::ValueOrDefault('$(NETCoreSdkVersion)', '0.0')), '6.0'))"
           Text="ZeroLog requires at least the .NET 6 SDK (Visual Studio 2022)." />
  </Target>

</Project>
