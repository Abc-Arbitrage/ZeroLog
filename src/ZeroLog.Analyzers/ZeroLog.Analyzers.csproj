<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>roslyn5.0;roslyn4.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' != ''">
    <TargetFrameworkIdentifier>.NETStandard</TargetFrameworkIdentifier>
    <TargetFrameworkVersion>v2.0</TargetFrameworkVersion>

    <RoslynVersion Condition="'$(TargetFramework)' == 'roslyn4.0'">4.0.1</RoslynVersion>
    <RoslynVersion Condition="'$(TargetFramework)' == 'roslyn5.0'">5.0.0</RoslynVersion>
  </PropertyGroup>

  <PropertyGroup>
    <DefineConstants>$(DefineConstants);ZEROLOG_ANALYZERS</DefineConstants>
    <DefineConstants Condition="'$(TargetFramework)' == 'roslyn5.0'">$(DefineConstants);ROSLYN5_0_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" VersionOverride="[$(RoslynVersion)]" PrivateAssets="all" Condition="'$(RoslynVersion)' != ''" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../ZeroLog/Properties/AssemblyData.cs" Link="Properties/AssemblyData.cs" />
    <Compile Include="../ZeroLog.Impl.Base/LogLevel.cs" Link="Library/%(Filename)%(Extension)" />
    <Compile Include="../ZeroLog.Impl.Full/Formatting/AnsiColorCodes.cs" Link="Library/%(Filename)%(Extension)" />
    <Compile Include="../ZeroLog.Impl.Full/Formatting/PatternWriter.cs" Link="Library/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
